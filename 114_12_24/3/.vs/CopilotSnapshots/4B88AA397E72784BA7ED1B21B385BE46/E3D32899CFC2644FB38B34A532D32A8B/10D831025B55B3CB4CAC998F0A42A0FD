using System;
using System.Collections.Generic;
using System.Linq;
using System.Windows.Forms;

namespace WinFormsApp1
{
    public partial class Form1 : Form
    {
        private Random _rnd = new Random();

        public Form1()
        {
            InitializeComponent();
        }

        private void btnGenerate_Click(object sender, EventArgs e)
        {
            // Generate 5 unique random numbers between 1 and 100 (user numbers)
            var numbers = new HashSet<int>();
            while (numbers.Count < 5)
            {
                int n = _rnd.Next(1, 101);
                numbers.Add(n);
            }
            var list = numbers.ToList();
            list.Sort();

            txtNum1.Text = list[0].ToString();
            txtNum2.Text = list[1].ToString();
            txtNum3.Text = list[2].ToString();
            txtNum4.Text = list[3].ToString();
            txtNum5.Text = list[4].ToString();
        }

        private void btnShow_Click(object sender, EventArgs e)
        {
            // Generate winning numbers (5 unique 1..100)
            var winning = new HashSet<int>();
            while (winning.Count < 5)
            {
                int n = _rnd.Next(1, 101);
                winning.Add(n);
            }
            var winList = winning.ToList();
            winList.Sort();

            // Show winning numbers in listbox
            listBoxResults.Items.Clear();
            listBoxResults.Items.Add("本期開獎號碼：");
            listBoxResults.Items.Add($"第1個號碼: {winList[0]}");
            listBoxResults.Items.Add($"第2個號碼: {winList[1]}");
            listBoxResults.Items.Add($"第3個號碼: {winList[2]}");
            listBoxResults.Items.Add($"第4個號碼: {winList[3]}");
            listBoxResults.Items.Add($"第5個號碼: {winList[4]}");

            // Read user numbers from textboxes
            var user = new List<int>();
            int v;
            if (int.TryParse(txtNum1.Text, out v)) user.Add(v);
            if (int.TryParse(txtNum2.Text, out v)) user.Add(v);
            if (int.TryParse(txtNum3.Text, out v)) user.Add(v);
            if (int.TryParse(txtNum4.Text, out v)) user.Add(v);
            if (int.TryParse(txtNum5.Text, out v)) user.Add(v);

            // Compare
            int match = user.Count(x => winning.Contains(x));
            lblMatchCount.Text = $"中{match}個號碼";

            if (match >= 3)
            {
                lblPrize.Text = "恭喜中獎！";
                lblPrize.ForeColor = System.Drawing.Color.Green;
            }
            else
            {
                lblPrize.Text = "沒中獎";
                lblPrize.ForeColor = System.Drawing.Color.Red;
            }
        }

        private void btnExit_Click(object sender, EventArgs e)
        {
            this.Close();
        }
    }
}
